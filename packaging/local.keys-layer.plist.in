<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Remapping service (root). The menu starts and stops this job.
  - RunAtLoad=false → cold boot stays off until Turn On
  - KeepAlive=true while the job is loaded → survives logout/login and sleep.
    Logout kills the menu, not this daemon. Turn Off / Quit bootouts the job.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.keys-layer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__KEYS_LAYER_BIN__</string>
    <string>__KEYS_LAYER_CONFIG__</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/var/log/keys-layer.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/keys-layer.log</string>
</dict>
</plist>
