<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Menu-bar owned remapping:
  - RunAtLoad=false → does NOT start at login/reboot (Turn On from the app)
  - KeepAlive=false → when keys-layer exits (menu quit / heartbeat lost), stay off
  - Process watches ~/.config/keys-layer/menu.heartbeat and exits if the menu is gone
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.keys-layer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__KEYS_LAYER_BIN__</string>
    <string>__KEYS_LAYER_CONFIG__</string>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/var/log/keys-layer.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/keys-layer.log</string>
</dict>
</plist>
